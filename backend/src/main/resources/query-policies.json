    "\\bперв\\w*\\s+(?:задач\\w*|задани\\w*|шаг\\w*)\\b.{0,100}\\b(?:моего|моей|моем|моих|у\\s+меня|my\\s+onboarding)\\b",
    "\\b(?:персональн\\w*\\s+)?план\\w*\\s+адаптац\\w*\\b.{0,90}\\bперв\\w*\\s+(?:задач\\w*|задани\\w*)\\b",
