  "REQUEST_PHRASES": [
    "\\b(?:мой|моя|моей|мою|мои|моих)\\s+(?:заявк\\w*|запрос\\w*)\\b",
    "\\b(?:статус|состояние)\\s+.{0,50}(?:заявк\\w*|запрос\\w*|доступ\\w*)",
    "\\b(?:заявк\\w*|запрос\\w*)\\s+.{0,40}(?:статус|одобр\\w*|отклон\\w*|рассмотр\\w*)",
    "\\b(?:одобр\\w*|отклони\\w*|рассмотр\\w*)\\s+.{0,45}(?:заявк\\w*|запрос\\w*)",
    "\\b(?:my|mine)\\s+(?:access\\s+)?requests?\\b",
    "\\bstatus\\s+of\\s+(?:my\\s+)?(?:access\\s+)?(?:request|application)\\b"
