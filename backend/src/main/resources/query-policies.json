  "TASK_PHRASES": [
    "\\b(?:мои|моих)\\s+(?:невыполненн\\w*\\s+|оставш\\w*\\s+)?(?:задач\\w*|задани\\w*|шаг\\w*)\\b",
    "\\b(?:какие|сколько)\\s+(?:у\\s+меня|мне)\\s+.{0,45}(?:задач\\w*|задани\\w*|шаг\\w*)\\b",
    "\\b(?:что|чего)\\s+(?:мне\\s+)?(?:еще\\s+)?(?:остал\\w*|выполнить|сделать)\\b",
    "\\b(?:какие|сколько)\\s+.{0,45}(?:задач\\w*|задани\\w*)\\s+(?:(?:у\\s+меня)|(?:мне))\\b",
    "\\b(?:задач\\w*|задани\\w*)\\s+.{0,35}(?:мною\\s+)?(?:выполн\\w*|остал\\w*|сделан\\w*)\\b",
    "\\b(?:my|mine)\\s+(?:remaining\\s+|pending\\s+|unfinished\\s+)?(?:onboarding\\s+)?tasks?\\b",
